#!/usr/bin/env python3
"""Run one lifted-wheel RPM test and stop without relying on operator timing."""
import time

import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from std_msgs.msg import Int16MultiArray, UInt8MultiArray


class MotorRpmTest(Node):
    def __init__(self):
        super().__init__('motor_rpm_test')
        self.motor = str(self.declare_parameter('motor', 'right').value)
        self.direction = str(self.declare_parameter('direction', 'forward').value)
        self.rpm = int(self.declare_parameter('rpm', 90).value)
        self.duration = float(self.declare_parameter('duration', 10.0).value)
        if self.motor not in ('left', 'right'):
            raise ValueError('motor must be left or right')
        if self.direction not in ('forward', 'reverse'):
            raise ValueError('direction must be forward or reverse')
        if not 1 <= self.rpm <= 100:
            raise ValueError('rpm must be between 1 and 100')
        if not 1.0 <= self.duration <= 120.0:
            raise ValueError('duration must be between 1 and 120 seconds')

        # Array positions are motor ID - 1: right=ID1, left=ID2. Mounted
        # motor directions differ, so vehicle-forward is + for right and - for left.
        vehicle_sign = 1 if self.direction == 'forward' else -1
        self.command = [0, 0]
        index = 0 if self.motor == 'right' else 1
        mounting_sign = 1 if self.motor == 'right' else -1
        self.command[index] = vehicle_sign * mounting_sign * self.rpm

        self.publisher = self.create_publisher(Int16MultiArray, '/ddsm115/rpm_cmd', 10)
        self.last_feedback = None
        self.online = set()
        self.create_subscription(
            Int16MultiArray, '/ddsm115/rpm_fb', self.feedback, qos_profile_sensor_data)
        self.create_subscription(
            UInt8MultiArray, '/ddsm115/online_id', self.online_ids, qos_profile_sensor_data)
        self.created = time.monotonic()
        self.ready_at = None
        self.started_at = None
        self.done = False
        self.failed = False
        self.create_timer(1.0 / 30.0, self.tick)
        self.get_logger().info(
            f'{self.motor} wheel {self.direction}: {self.rpm} RPM for '
            f'{self.duration:.1f}s; waiting for motor feedback and recorder')

    def feedback(self, _message):
        self.last_feedback = time.monotonic()

    def online_ids(self, message):
        self.online = set(message.data)

    def publish(self, values):
        self.publisher.publish(Int16MultiArray(data=values))

    def tick(self):
        now = time.monotonic()
        if self.started_at is None:
            # velocity_control and rosbag must both subscribe before countdown.
            ready = (self.publisher.get_subscription_count() >= 2 and
                     self.last_feedback is not None and now - self.last_feedback < 0.5 and
                     {1, 2}.issubset(self.online))
            self.publish([0, 0])
            if not ready:
                self.ready_at = None
            elif self.ready_at is None:
                self.ready_at = now
                self.get_logger().info('Motors and recorder ready. Rotation starts in 10 seconds.')
            elif now - self.ready_at >= 10.0:
                self.started_at = now
                self.get_logger().info(
                    f'Start counting now: expected {self.rpm * self.duration / 60.0:.3f} turns')
            if now - self.created > 60.0 and self.started_at is None:
                self.failed = self.done = True
                self.get_logger().error('Readiness timeout; motor was not started')
            return

        elapsed = now - self.started_at
        if elapsed < self.duration:
            if self.last_feedback is None or now - self.last_feedback > 0.5 or not {1, 2}.issubset(self.online):
                self.failed = self.done = True
                self.publish([0, 0])
                self.get_logger().error('Motor feedback lost; stopping test')
            else:
                self.publish(self.command)
        else:
            self.publish([0, 0])
            if elapsed >= self.duration + 3.0:
                self.done = True
                self.get_logger().info('Test complete after 3 seconds of zero RPM commands')


def main():
    rclpy.init()
    node = MotorRpmTest()
    try:
        while rclpy.ok() and not node.done:
            rclpy.spin_once(node, timeout_sec=0.1)
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            for _ in range(5):
                node.publish([0, 0])
                rclpy.spin_once(node, timeout_sec=0.02)
        failed = node.failed
        node.destroy_node()
        rclpy.try_shutdown()
    if failed:
        raise SystemExit(1)


if __name__ == '__main__':
    main()
