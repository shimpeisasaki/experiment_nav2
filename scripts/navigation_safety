#!/usr/bin/env python3
"""Latched navigation/manual command gate with joystick mode selection.

Not a certified emergency stop. Driver lease and physical stop remain necessary.
The timer uses steady time; TF/header ages use ROS time. No automatic re-arm.
"""
import math
import time
import rclpy
from rclpy.node import Node
from rclpy.clock import Clock, ClockType
from rclpy.time import Time
from rclpy.qos import QoSProfile, DurabilityPolicy, ReliabilityPolicy, qos_profile_sensor_data
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from sensor_msgs.msg import Joy, LaserScan
from std_msgs.msg import UInt8, Bool, String, Int16MultiArray, UInt8MultiArray
from std_srvs.srv import Trigger
from action_msgs.msg import GoalStatusArray
from action_msgs.srv import CancelGoal
from tf2_ros import Buffer, TransformListener


class NavigationSafety(Node):
    def __init__(self):
        super().__init__('navigation_safety')
        self.b = self.declare_parameter('brake_button', 1).value
        self.y = self.declare_parameter('free_button', 3).value
        self.a = self.declare_parameter('navigation_button', 0).value
        self.x = self.declare_parameter('manual_button', 2).value
        self.mode = 0
        self.drive_source = 'navigation'
        self.pending_drive = None
        self.reason = 'Startup: brake; initialize localization, then press A or call ~/arm'
        self.fresh = {}
        self.stamps = {}
        self.buttons = []
        self.raw = {'navigation': Twist(), 'manual': Twist()}
        self.last_command = {'navigation': -math.inf, 'manual': -math.inf}
        self.armed_at = math.inf
        self.pending_free = None
        self.stopped_since = None
        self.ids = []
        self.rpm = None
        self.last_tick = time.monotonic()
        self.ready_since = None
        self.last_cancel = -math.inf
        self.active = {}
        self.buffer = Buffer()
        self.listener = TransformListener(self.buffer, self)
        self.output = self.create_publisher(Twist, '/cmd_vel_safe', 1)
        self.lease = self.create_publisher(UInt8, '/navigation_safety/mode', 1)
        status_qos = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                                durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.status = self.create_publisher(String, '~/status', status_qos)
        self.create_subscription(
            Twist, '/cmd_vel_collision', lambda msg: self.command('navigation', msg), 1)
        self.create_subscription(
            Twist, '/cmd_vel_teleop', lambda msg: self.command('manual', msg), 1)
        self.create_subscription(Joy, '/joy', self.joy, qos_profile_sensor_data)
        self.create_subscription(Odometry, '/odom', self.odom, qos_profile_sensor_data)
        self.create_subscription(LaserScan, '/scan', self.scan, qos_profile_sensor_data)
        self.create_subscription(Int16MultiArray, '/ddsm115/rpm_fb', self.feedback, qos_profile_sensor_data)
        self.create_subscription(UInt8MultiArray, '/ddsm115/online_id', self.online, qos_profile_sensor_data)
        self.create_subscription(Bool, '/ddsm115/brake', self.external_brake, qos_profile_sensor_data)
        self.create_service(Trigger, '~/arm', self.arm)
        self.create_service(Trigger, '~/brake', self.brake_service)
        self.create_service(Trigger, '~/free', self.free_service)
        self.cancel_clients = {}
        self.cancel_futures = {}
        for name in ('navigate_to_pose', 'navigate_through_poses', 'follow_waypoints',
                     'follow_path', 'spin', 'backup', 'wait', 'drive_on_heading', 'assisted_teleop'):
            self.cancel_clients[name] = self.create_client(CancelGoal, f'/{name}/_action/cancel_goal')
            self.create_subscription(GoalStatusArray, f'/{name}/_action/status',
                                     lambda m, n=name: self.goal_status(n, m), status_qos)
        self.create_timer(.05, self.tick, clock=Clock(clock_type=ClockType.STEADY_TIME))
        self.get_logger().warning(self.reason)

    def goal_status(self, name, msg):
        self.active[name] = any(s.status in (1, 2, 3) for s in msg.status_list)

    def header_ok(self, key, header):
        t = header.stamp.sec + header.stamp.nanosec*1e-9
        now = self.get_clock().now().nanoseconds*1e-9
        if not -.1 <= now-t <= .5 or t <= self.stamps.get(key, -math.inf):
            return False
        self.stamps[key] = t
        self.fresh[key] = time.monotonic()
        return True

    def odom(self, msg):
        p, q = msg.pose.pose.position, msg.pose.pose.orientation
        if (msg.header.frame_id == 'odom' and msg.child_frame_id == 'base_link' and
                all(math.isfinite(v) for v in (p.x, p.y, p.z, q.x, q.y, q.z, q.w)) and
                .9 < q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w < 1.1):
            self.header_ok('odom', msg.header)

    def scan(self, msg):
        if any(math.isfinite(v) and msg.range_min <= v <= msg.range_max for v in msg.ranges):
            self.header_ok('scan', msg.header)

    def feedback(self, msg):
        if len(msg.data) >= 2 and all(v != -32768 for v in msg.data[:2]):
            self.rpm = list(msg.data[:2])
            self.fresh['rpm'] = time.monotonic()

    def online(self, msg):
        self.ids = list(msg.data)
        self.fresh['online'] = time.monotonic()

    def joy(self, msg):
        if len(msg.buttons) <= max(self.a, self.b, self.x, self.y) or not self.header_ok('joy', msg.header):
            return
        previous = self.buttons
        self.buttons = list(msg.buttons)
        pressed = lambda i: self.buttons[i] and (not previous or not previous[i])
        if self.buttons[self.b]:  # brake always wins over simultaneous Y
            self.stop('Joystick B')
        elif pressed(self.y):
            self.request_free()
        elif pressed(self.a):
            self.request_drive('navigation')
        elif pressed(self.x):
            self.request_drive('manual')

    def command(self, source, msg):
        values = [msg.linear.x, msg.linear.y, msg.linear.z,
                  msg.angular.x, msg.angular.y, msg.angular.z]
        if not all(math.isfinite(v) for v in values):
            self.stop('Invalid cmd_vel')
            return
        if abs(msg.linear.x) > 2. or abs(msg.angular.z) > 3. or abs(msg.linear.y) > .001:
            self.stop('cmd_vel exceeds safety envelope')
            return
        self.raw[source] = msg
        self.last_command[source] = time.monotonic()

    def external_brake(self, msg):
        if msg.data:
            self.stop('External brake command')

    def stop(self, reason):
        changed = self.mode != 0 or self.reason != reason
        self.mode = 0
        self.pending_free = None
        self.pending_drive = None
        self.stopped_since = None
        self.ready_since = None
        self.armed_at = math.inf
        self.reason = reason
        self.output.publish(Twist())
        self.lease.publish(UInt8(data=0))
        if changed:
            self.get_logger().warning('BRAKE: '+reason)

    def request_free(self):
        self.stop('Free requested: braking until wheel feedback confirms rest')
        self.pending_free = time.monotonic()

    def activate_drive(self, source):
        self.mode = 2
        self.drive_source = source
        self.pending_drive = None
        self.armed_at = time.monotonic()
        self.reason = ('NAVIGATION: Nav2 command enabled' if source == 'navigation' else
                       'MANUAL: X selected, right stick enabled')

    def request_drive(self, source):
        if self.mode == 2:
            if self.drive_source == source:
                return
            self.stop(f'Switching to {source}: braking before source change')
        # Leaving freewheel always passes through a braking, stationary state.
        if self.mode == 1 or self.pending_free is not None:
            self.stop('Leaving FREE: braking before drive')
        self.pending_drive = source
        self.reason = f'{source.upper()} requested: waiting for 2s healthy stationary state'

    def physical_problem(self):
        now = time.monotonic()
        for key, limit in (('joy', .5), ('rpm', .3), ('online', 1.2)):
            if now-self.fresh.get(key, -math.inf) > limit:
                return key+' stale/missing'
        if not all(i in self.ids for i in (1, 2)):
            return 'Motor offline'
        return None

    def problem(self):
        issue = self.physical_problem()
        if issue:
            return issue
        for topic, owner in (('/cmd_vel_safe', self.get_name()),
                             ('/navigation_safety/mode', self.get_name()),
                             ('/cmd_vel_collision', 'collision_monitor'),
                             ('/cmd_vel_teleop', 'velocity_smoother_manual'),
                             ('/ddsm115/rpm_cmd', 'two_wheels_robot_node')):
            publishers = self.get_publishers_info_by_topic(topic)
            if len(publishers) != 1 or publishers[0].node_name != owner:
                return 'Unexpected/missing publisher: '+topic
        now = time.monotonic()
        for key in ('odom', 'scan'):
            if now-self.fresh.get(key, -math.inf) > .5:
                return key+' stale/missing/invalid'
        ros_now = self.get_clock().now().nanoseconds*1e-9
        for parent, child, tolerance in (('odom', 'base_link', .5), ('map', 'odom', 1.5)):
            try:
                tf = self.buffer.lookup_transform(parent, child, Time())
                stamp = tf.header.stamp.sec + tf.header.stamp.nanosec*1e-9
                if stamp == 0 or not -1.5 <= ros_now-stamp <= tolerance:
                    return parent+' -> '+child+' TF stale/future'
            except Exception:
                return parent+' -> '+child+' TF unavailable'
        return None

    def arm(self, _, response):
        issue = self.problem()
        nav = self.raw['navigation']
        fresh_nonzero = (time.monotonic()-self.last_command['navigation'] < .5 and
                         (abs(nav.linear.x) > .001 or abs(nav.angular.z) > .001))
        if self.mode != 0 or self.pending_free is not None:
            issue = 'Press B / call brake before arming'
        elif self.ready_since is None or time.monotonic()-self.ready_since < 2:
            issue = issue or 'Healthy and stationary state required for 2 seconds'
        elif fresh_nonzero:
            issue = 'Navigation command is nonzero; wait for zero before arming'
        elif not self.buttons or self.buttons[self.b] or self.buttons[self.y]:
            issue = 'Release joystick B/Y first'
        if issue:
            response.message = issue
            return response
        self.activate_drive('navigation')
        response.success = True
        response.message = 'NAVIGATION enabled; an existing or new goal may run'
        return response

    def brake_service(self, _, response):
        self.stop('Operator brake service')
        response.success = True
        response.message = 'Brake requested; inspect wheel stop'
        return response

    def free_service(self, _, response):
        self.request_free()
        response.success = True
        response.message = 'Free pending: requires fresh joystick and stationary motor feedback'
        return response

    def cancel_goals(self, now):
        if now-self.last_cancel < .5:
            return
        self.last_cancel = now
        for name, client in self.cancel_clients.items():
            future = self.cancel_futures.get(name)
            if client.service_is_ready() and (future is None or future.done()):
                # Zero UUID/time means cancel ALL goals on this action server.
                self.cancel_futures[name] = client.call_async(CancelGoal.Request())

    def tick(self):
        now = time.monotonic()
        if now-self.last_tick > .25 and self.mode != 0:
            self.stop('Safety timer stalled')
        self.last_tick = now
        if self.mode == 2:
            issue = self.problem()
            if issue:
                self.stop(issue)
        if self.mode == 1 or self.pending_free is not None:
            issue = self.physical_problem()
            if issue:
                self.stop(issue)
        if self.pending_free is not None:
            if self.rpm is not None and max(abs(v) for v in self.rpm) <= 1:
                self.stopped_since = self.stopped_since or now
                if now-self.stopped_since >= .3:
                    self.mode = 1
                    self.pending_free = None
                    self.reason = 'FREE: motor torque disabled; vehicle may roll'
            else:
                self.stopped_since = None
            if self.pending_free is not None and now-self.pending_free > 3:
                self.stop('Free rejected: wheels did not stop')
        if self.mode != 2:
            healthy = (self.problem() is None and self.rpm is not None and
                       max(abs(v) for v in self.rpm) <= 1)
            self.ready_since = (self.ready_since or now) if healthy else None
            if (healthy and self.pending_drive is not None and
                    now-self.ready_since >= 2):
                self.activate_drive(self.pending_drive)
        source = self.drive_source
        fresh = (now-self.last_command[source] <= .3 and
                 self.last_command[source] > self.armed_at)
        self.output.publish(self.raw[source] if self.mode == 2 and fresh else Twist())
        self.lease.publish(UInt8(data=self.mode))
        self.status.publish(String(data=f'{self.mode}: {self.reason}'))


def main():
    rclpy.init()
    node = NavigationSafety()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        # If ROS context is already closed, the independent driver lease still expires.
        if rclpy.ok():
            node.stop('Safety node shutdown')
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
